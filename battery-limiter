#!/usr/bin/python3
"""ASUS Battery Limiter 2.0: three modes, adaptive charge window, tray and service."""
import argparse
import json
import os
import pwd
import shutil
import subprocess
import sys
import time
from pathlib import Path

BATTERY = Path("/sys/class/power_supply/BAT0")
CONFIG = Path.home() / ".config/battery-limiter.json"
RUNTIME = Path("/run/battery-limiter.json")
STATE = Path("/var/lib/battery-limiter/state.json")
SERVICE = Path("/etc/systemd/system/battery-limiter.service")
INSTALLED = Path("/usr/local/libexec/battery-limiter")
MODE_NAMES = {"full": "Полный заряд", "life": "Ресурс батареи", "off": "Без зарядки"}
MODE_KEYS = {"1": "full", "2": "life", "3": "off"}
POLL_SECONDS = 15


def read(name):
    try:
        return (BATTERY / name).read_text().strip()
    except OSError:
        return None


def number(name):
    try:
        return int(read(name))
    except (TypeError, ValueError):
        return None


def battery_info():
    return {
        "manufacturer": read("manufacturer") or "",
        "model": read("model_name") or "",
        "technology": read("technology") or "",
        "design": number("energy_full_design") or number("charge_full_design"),
        "full": number("energy_full") or number("charge_full"),
        "cycles": number("cycle_count"),
    }


def profile(info, cycle):
    """ASUS officially recommends 60% for AC use; 50% restart is a software heuristic."""
    if not info["manufacturer"].lower().startswith("asustek") or info["technology"].lower() != "li-ion":
        raise ValueError("Нет подтверждённого профиля для этой батареи")
    full, design = info["full"], info["design"]
    health = full / design if full and design else None
    if health is not None and not 0.25 <= health <= 1.05:
        health = None  # Invalid calibration must not influence thresholds.
    wear = health is not None and health < 0.80
    shift = cycle % 3
    low = (48 if wear else 50) - shift
    high = 60 - shift - int(wear)
    return low, high, health


def battery_id(info):
    return "|".join(str(info[k]) for k in ("manufacturer", "model", "technology", "design"))


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def atomic_json(path, data, private=False):
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        temp.write_text(json.dumps(data, ensure_ascii=False) + "\n")
        os.chmod(temp, 0o600 if private else 0o644)
        os.replace(temp, path)
    finally:
        temp.unlink(missing_ok=True)


def get_mode(path=CONFIG):
    data = json.loads(path.read_text())
    mode = data.get("mode")
    if mode is None and isinstance(data.get("threshold"), int):
        mode = "full" if data["threshold"] == 100 else "life"
    if mode not in MODE_NAMES:
        raise ValueError("Некорректный режим в конфигурации")
    return mode


def off_supported():
    # A charge threshold is not a charging disable switch.
    return (BATTERY / "charging_enabled").is_file()


def decide(mode, capacity, info, previous):
    """Pure state transition: no sysfs writes. Returns state, requested limit and events."""
    if not 0 <= capacity <= 100:
        raise ValueError("Недостоверный процент заряда")
    old = previous or {}
    current = dict(old)
    events = []
    ident = battery_id(info)
    fresh = old.get("mode") != mode or old.get("battery_id") != ident
    if fresh:
        current["mode"] = mode
        current["battery_id"] = ident
        current["cycle"] = old.get("cycle", 0) if old.get("battery_id") == ident else 0
        current["full_notified"] = capacity == 100
        if mode == "life":
            low, high, health = profile(info, current["cycle"])
            current.update({"min": low, "max": high, "health": health,
                            "phase": "charging" if capacity < low else "hold"})
        elif mode == "full":
            current.update({"min": None, "max": 100, "phase": "full"})
        else:
            current.update({"min": None, "max": None, "phase": "off"})

    if mode == "off":
        if not off_supported():
            raise RuntimeError("Режим 3 не поддерживается: аппаратного отключения зарядки нет")
        target = None
    elif mode == "full":
        target = 100
    else:
        if current["phase"] == "charging" and capacity >= current["max"]:
            events.append(f"Достигнут верхний порог {current['max']}%")
            current["cycle"] += 1
            low, high, health = profile(info, current["cycle"])
            current.update({"min": low, "max": high, "health": health, "phase": "hold"})
        elif current["phase"] == "hold" and capacity < current["min"]:
            events.append(f"Достигнут нижний порог {current['min']}%")
            current["phase"] = "charging"
        target = current["max"] if current["phase"] == "charging" else current["min"]
    return current, target, events


def set_file(name, value):
    path = BATTERY / name
    if not path.is_file():
        raise RuntimeError(f"Нет аппаратного управления: {name}")
    if read(name) == str(value):
        return
    path.write_text(str(value))
    if read(name) != str(value):
        raise RuntimeError(f"Контроллер не подтвердил {name}={value}")


def event(state, message):
    state["event_id"] = state.get("event_id", 0) + 1
    state["events"] = (state.get("events", []) + [
        {"id": state["event_id"], "message": message}
    ])[-10:]


def step(config_path, previous):
    mode = get_mode(config_path)
    capacity = number("capacity")
    if capacity is None:
        raise RuntimeError("Не удалось прочитать заряд аккумулятора")
    state, target, messages = decide(mode, capacity, battery_info(), previous)
    if mode == "off":
        set_file("charging_enabled", 0)
    else:
        if off_supported():
            set_file("charging_enabled", 1)
        set_file("charge_control_end_threshold", target)
    status = read("status") or "Unknown"
    if status == "Charging" and previous.get("status") not in (None, "Charging"):
        messages.append("Зарядка аккумулятора началась")
    if mode == "full":
        if capacity < 100:
            state["full_notified"] = False
        elif status in ("Full", "Not charging") and not state.get("full_notified", False):
            messages.append("Достигнут полный заряд 100%")
            state["full_notified"] = True
    for message in messages:
        event(state, message)
    state.update({"capacity": capacity, "status": status})
    return state


def monitor(config_path):
    if os.geteuid() != 0:
        raise PermissionError("Контроллер должен работать с правами root")
    previous = read_json(STATE)
    last_error = None
    while True:
        try:
            updated = step(config_path, previous)
            if updated != previous:
                atomic_json(STATE, updated)
            previous = updated
            error = None
        except (OSError, ValueError, RuntimeError, KeyError) as exc:
            error = str(exc)
            if error != last_error:
                print(f"Battery Limiter: {error}", file=sys.stderr, flush=True)
        last_error = error
        atomic_json(RUNTIME, {**previous, "error": error, "timestamp": time.time()})
        time.sleep(POLL_SECONDS)


def live_state():
    state = read_json(RUNTIME)
    return state if time.time() - state.get("timestamp", 0) < 60 else {}


def set_mode(mode):
    if mode == "off" and not off_supported():
        raise RuntimeError("Режим 3 недоступен: у батареи отсутствует charging_enabled")
    if not live_state():
        raise RuntimeError("Контроллер не запущен; текущие настройки не изменены")
    atomic_json(CONFIG, {"mode": mode}, private=True)


def status():
    state = live_state()
    try:
        mode = get_mode()
    except (OSError, ValueError, json.JSONDecodeError):
        mode = None
    print("Режим:", MODE_NAMES.get(mode, "не задан"))
    print("Заряд:", number("capacity"), "%; состояние:", read("status"))
    print("Аппаратный порог:", number("charge_control_end_threshold"))
    if state:
        print("MIN/MAX:", state.get("min"), "/", state.get("max"),
              "; фаза:", state.get("phase"))
        if state.get("error"):
            print("Ошибка:", state["error"])
    else:
        print("Контроллер не запущен или не отвечает")
    if not off_supported():
        print("Режим 3: аппаратно недоступен")


def notify(message):
    try:
        subprocess.run(["notify-send", "-a", "ASUS Battery Limiter",
                        "Аккумулятор", message], check=False, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        pass



# Letter О is an outline; digit 0 is a filled dot. The icon follows the GTK theme.
ICON_FRAMES = {
    "full": ("ООО", "0ОО", "О0О", "ОО0", "0О0", "О00", "000"),
    "life": ("О0О", "ОО0", "О0О", "0ОО"),
    "off": ("ООО",),
}
ICON_DIR = Path.home() / ".local/share/icons/hicolor/scalable/apps"


def frame_icon_name(frame):
    return "battery-limiter-" + frame.replace("О", "o").replace("0", "x") + "-symbolic"


def frame_svg(frame):
    circles = []
    for x, symbol in zip((3, 8, 13), frame):
        fill = "#bebebe" if symbol == "0" else "none"
        circles.append(f'<circle cx="{x}" cy="8" r="1.9" fill="{fill}" '
                       'stroke="#bebebe" stroke-width="1.25"/>')
    return ('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" '
            'viewBox="0 0 16 16">' + "".join(circles) + '</svg>\n')


def ensure_frame_icons(directory=ICON_DIR):
    directory.mkdir(parents=True, exist_ok=True)
    for frame in {item for frames in ICON_FRAMES.values() for item in frames}:
        dest = directory / (frame_icon_name(frame) + ".svg")
        svg = frame_svg(frame)
        if not dest.exists() or dest.read_text() != svg:
            dest.write_text(svg)


def mode_hint(mode, state):
    if mode == "full":
        return "Зарядка до 100%."
    if mode == "life":
        low, high = state.get("min"), state.get("max")
        if isinstance(low, int) and isinstance(high, int):
            return f"Ниже {low}% — зарядка до {high}%. Внутри {low}–{high}% не начинается."
        return "Границы зарядки рассчитываются автоматически."
    return ("Полностью отключает зарядку."
            if off_supported() else "Недоступно: нет аппаратного отключения зарядки.")


def tray():
    """Show three charge modes and a theme-colored animated vector status icon."""
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import GLib, Gtk
    except (ImportError, ValueError) as exc:
        raise RuntimeError("Нужны python3-gi и Gtk3") from exc

    ensure_frame_icons()
    Gtk.IconTheme.get_default().rescan_if_needed()
    # shortcut: Gtk.StatusIcon requires X11/XEmbed; replace it if this desktop moves to Wayland.
    indicator = Gtk.StatusIcon.new_from_icon_name(frame_icon_name(ICON_FRAMES["off"][0]))
    menu = Gtk.Menu()
    first = None
    items = {}
    editing = False
    last_event_id = None
    hovered = None
    frame_index = 0

    def state_line(state):
        if not state:
            return "Контроллер не запущен"
        if state.get("error"):
            return "Ошибка: " + state["error"]
        return f"{state.get('capacity')}% · {state.get('status')}"

    info_item = Gtk.MenuItem(label="Считывание состояния…")
    info_item.set_sensitive(False)

    def show_hint(_widget, key):
        nonlocal hovered
        hovered = key
        info_item.set_label(mode_hint(key, live_state()))

    def clear_hint(*_):
        nonlocal hovered
        hovered = None
        info_item.set_label(state_line(live_state()))

    def changed(widget, mode):
        if editing or not widget.get_active():
            return
        try:
            set_mode(mode)
        except (OSError, RuntimeError) as exc:
            notify(str(exc))
        refresh()
        animate()

    for key, name in MODE_NAMES.items():
        item = (Gtk.RadioMenuItem(label=name) if first is None else
                Gtk.RadioMenuItem(group=first, label=name))
        first = first or item
        item.connect("toggled", changed, key)
        item.connect("select", show_hint, key)
        item.connect("deselect", clear_hint)
        menu.append(item)
        items[key] = item
    menu.append(Gtk.SeparatorMenuItem())
    menu.append(info_item)
    quit_item = Gtk.MenuItem(label="Выход из индикатора")
    quit_item.connect("activate", lambda *_: Gtk.main_quit())
    menu.append(quit_item)
    menu.show_all()
    indicator.connect("activate", lambda *_: menu.popup_at_pointer(None))
    indicator.connect("popup-menu", lambda *_: menu.popup_at_pointer(None))

    def current_mode():
        try:
            return get_mode()
        except (OSError, ValueError, json.JSONDecodeError):
            return None

    def refresh():
        nonlocal editing, last_event_id
        state = live_state()
        selected = current_mode()
        editing = True
        try:
            for key, item in items.items():
                if key == selected and not item.get_active():
                    item.set_active(True)
                item.set_sensitive(bool(state))
                item.set_tooltip_text(mode_hint(key, state))
        finally:
            editing = False
        indicator.set_tooltip_text("Режим: " + MODE_NAMES.get(selected, "неизвестен"))
        if not hovered:
            info_item.set_label(state_line(state))
        if state:
            events = state.get("events", [])
            if last_event_id is not None:
                for item in events:
                    if item["id"] > last_event_id:
                        notify(item["message"])
            last_event_id = state.get("event_id", 0)
        else:
            last_event_id = None
        return True

    def animate():
        nonlocal frame_index
        mode = current_mode()
        frames = ICON_FRAMES.get(mode, ICON_FRAMES["off"])
        indicator.set_from_icon_name(frame_icon_name(frames[frame_index % len(frames)]))
        frame_index += 1
        return True

    refresh()
    animate()
    GLib.timeout_add(550, animate)
    GLib.timeout_add_seconds(10, refresh)
    Gtk.main()

def install(user):
    if os.geteuid() != 0:
        raise PermissionError("Установку необходимо выполнять с правами администратора")
    account = pwd.getpwnam(user)
    home = Path(account.pw_dir)
    config = home / ".config/battery-limiter.json"
    user_binary = home / "bin/battery-limiter"
    if not config.is_file() or not user_binary.is_file():
        raise FileNotFoundError("Не найдены существующие настройки или установленная программа")
    for path in (SERVICE, user_binary, config):
        backup = Path(str(path) + ".v1.bak")
        if path.exists() and not backup.exists():
            shutil.copy2(path, backup)

    INSTALLED.parent.mkdir(parents=True, exist_ok=True)
    source = Path(__file__).resolve()
    candidate = INSTALLED.with_name(INSTALLED.name + ".new")
    shutil.copyfile(source, candidate)
    candidate.chmod(0o755)
    os.replace(candidate, INSTALLED)
    unit = f"""[Unit]
Description=ASUS Battery Limiter adaptive charge controller
After=local-fs.target
ConditionPathExists=/sys/class/power_supply/BAT0/charge_control_end_threshold

[Service]
Type=simple
ExecStart={INSTALLED} --monitor --config {config}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
"""
    try:
        SERVICE.write_text(unit)
        subprocess.run(["systemctl", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "enable", "--now", "battery-limiter.service"], check=True)
        started_at = time.time()
        subprocess.run(["systemctl", "restart", "battery-limiter.service"], check=True)
        subprocess.run(["systemctl", "is-active", "--quiet", "battery-limiter.service"], check=True)
        for _ in range(30):
            snapshot = live_state()
            if snapshot.get("timestamp", 0) >= started_at:
                if snapshot.get("error"):
                    raise RuntimeError("Контроллер отклонил настройки: " + snapshot["error"])
                expected = (100 if snapshot.get("mode") == "full" else
                            snapshot.get("max") if snapshot.get("phase") == "charging" else
                            snapshot.get("min"))
                if snapshot.get("mode") == get_mode(config) and (
                    snapshot.get("mode") == "off" or number("charge_control_end_threshold") == expected
                ):
                    break
            time.sleep(0.2)
        else:
            raise RuntimeError("Нет подтверждения применения порога от контроллера")
        replacement = user_binary.with_name(".battery-limiter.v2.new")
        shutil.copyfile(source, replacement)
        replacement.chmod(0o755)
        os.chown(replacement, account.pw_uid, account.pw_gid)
        os.replace(replacement, user_binary)
    except (OSError, RuntimeError, subprocess.CalledProcessError):
        backup = Path(str(SERVICE) + ".v1.bak")
        if backup.exists():
            shutil.copy2(backup, SERVICE)
        else:
            SERVICE.unlink(missing_ok=True)
        subprocess.run(["systemctl", "daemon-reload"], check=False)
        subprocess.run(["systemctl", "restart", "battery-limiter.service"], check=False)
        raise
    print("Версия 2 установлена. Перезапустите значок в трее; проверьте режимы и порог")


def uninstall():
    if os.geteuid() != 0:
        raise PermissionError("Удаление службы требует прав администратора")
    subprocess.run(["systemctl", "disable", "--now", "battery-limiter.service"], check=True)
    SERVICE.unlink(missing_ok=True)
    INSTALLED.unlink(missing_ok=True)
    subprocess.run(["systemctl", "daemon-reload"], check=True)
    print("Служба удалена; текущий аппаратный порог не менялся")


def main():
    parser = argparse.ArgumentParser(description="Три режима заряда ASUS")
    parser.add_argument("--tray", action="store_true")
    parser.add_argument("--monitor", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--config", type=Path, help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="cmd")
    mode_parser = sub.add_parser("mode", help="1: 100%; 2: ресурс; 3: без зарядки")
    mode_parser.add_argument("level", choices=MODE_KEYS)
    sub.add_parser("status")
    install_parser = sub.add_parser("install")
    install_parser.add_argument("--user", required=True, help="Имя пользователя рабочего стола")
    sub.add_parser("uninstall")
    args = parser.parse_args()
    try:
        if args.monitor:
            if not args.config:
                parser.error("--monitor требует --config")
            monitor(args.config)
        elif args.tray:
            tray()
        elif args.cmd == "mode":
            set_mode(MODE_KEYS[args.level])
            print("Выбран режим:", MODE_NAMES[MODE_KEYS[args.level]])
        elif args.cmd == "status":
            status()
        elif args.cmd == "install":
            install(args.user)
        elif args.cmd == "uninstall":
            uninstall()
        else:
            parser.print_help()
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as exc:
        print("Ошибка:", exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
